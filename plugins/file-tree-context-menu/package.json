{
  "name": "@local/file-tree-context-menu",
  "version": "1.1.0",
  "description": "Right-click files or folders in the workspace file tree and deliverable lists to add them to the conversation, copy paths, open them with the default app or a browser, or reveal them in the file manager.",
  "private": true,
  "type": "module",
  "author": "Mark930209 <guimaxingtian@163.com>",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "context-menu",
    "file-tree",
    "mention",
    "workspace",
    "open-in-app",
    "reveal",
    "browser"
  ],
  "homepage": "https://github.com/Mark930209/GoDSH/tree/main/plugins/file-tree-context-menu",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mark930209/GoDSH.git",
    "directory": "plugins/file-tree-context-menu"
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-files",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
