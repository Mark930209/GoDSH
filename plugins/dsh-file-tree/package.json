{
  "name": "dsh-file-tree",
  "version": "1.0.1",
  "description": "Right-click files or folders in the workspace file tree and deliverable lists to see Git change status, add them to the conversation, copy paths/links, preview in DSH, open in a terminal, summarize with AI, create/rename/delete entries, or reveal them in the file manager.",
  "type": "module",
  "author": "Mark930209 <guimaxingtian@163.com>",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "context-menu",
    "file-tree",
    "mention",
    "workspace",
    "open-in-app",
    "reveal",
    "browser",
    "preview",
    "terminal",
    "new-file",
    "new-folder",
    "rename",
    "delete",
    "recycle-bin",
    "multi-select",
    "git",
    "git-status",
    "ai"
  ],
  "homepage": "https://github.com/Mark930209/GoDSH/tree/main/plugins/dsh-file-tree",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mark930209/GoDSH.git",
    "directory": "plugins/dsh-file-tree"
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-files",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
